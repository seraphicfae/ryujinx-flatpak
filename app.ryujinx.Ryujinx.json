{
  "app-id": "app.ryujinx.Ryujinx",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "26.08",
  "sdk": "org.freedesktop.Sdk",
  "command": "ryujinx-launcher",
  "sdk-extensions": ["org.freedesktop.Sdk.Extension.dotnet10"],
  "finish-args": [
    "--share=network",
    "--share=ipc",
    "--socket=wayland",
    "--socket=x11",
    "--socket=pulseaudio",
    "--device=dri",
    "--device=input",
    "--device-if=all:!has-input-device",
    "--filesystem=xdg-run/app/com.discordapp.Discord:create",
    "--env=DOTNET_ROOT=/app/lib/dotnet"
  ],
  "build-options": {
    "prepend-path": "/usr/lib/sdk/dotnet10/bin",
    "append-ld-library-path": "/usr/lib/sdk/dotnet10/lib",
    "prepend-pkg-config-path": "/usr/lib/sdk/dotnet10/lib/pkgconfig",
    "env": {
      "PKG_CONFIG_PATH": "/app/lib/pkgconfig:/app/share/pkgconfig:/usr/lib/pkgconfig:/usr/share/pkgconfig:/usr/lib/sdk/dotnet10/lib/pkgconfig",
      "DOTNET_CLI_TELEMETRY_OPTOUT": "true",
      "DOTNET_SKIP_FIRST_TIME_EXPERIENCE": "true",
      "container": "flatpak"
    },
    "arch": {
      "aarch64": {
        "env": ["RUNTIME=linux-arm64"]
      },
      "x86_64": {
        "env": ["RUNTIME=linux-x64"]
      }
    }
  },
  "modules": [
    {
      "name": "dotnet-runtime",
      "buildsystem": "simple",
      "build-commands": ["/usr/lib/sdk/dotnet10/bin/install.sh"]
    },
    {
      "name": "ryujinx",
      "buildsystem": "simple",
      "builddir": true,
      "build-commands": [
        "dotnet publish src/Ryujinx/Ryujinx.csproj -c Release -r $RUNTIME --source nuget-sources --self-contained true -o ${FLATPAK_DEST}/bin",
        "install -Dm644 distribution/linux/app.ryujinx.Ryujinx.desktop /app/share/applications",
        "install -Dm644 distribution/linux/mime/Ryujinx.xml /app/share/mime/packages/app.ryujinx.Ryujinx.xml",
        "install -Dm644 app.ryujinx.Ryujinx.metainfo.xml /app/share/metainfo",
        "install -Dm755 ryujinx-launcher.sh /app/bin/ryujinx-launcher",
        "desktop-file-edit --set-key Exec --set-value ryujinx-launcher /app/share/applications/app.ryujinx.Ryujinx.desktop"
      ],
      "sources": [
        "nuget-sources.json",
        {
          "type": "file",
          "path": "app.ryujinx.Ryujinx.metainfo.xml"
        },
        {
          "type": "file",
          "path": "ryujinx-launcher.sh"
        },
        {
          "type": "git",
          "url": "https://git.ryujinx.app/projects/Ryubing",
          "tag": "Canary-1.3.356",
          "commit": "eaff2d332fb3010e2e4a43a5f3168432deae3395"
        }
      ]
    }
  ]
}
